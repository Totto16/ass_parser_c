{
	"trailingComma": "es5",
	"tabWidth": 4,
	"semi": false,
	"useTabs": true,
	"singleQuote": true,
	"overrides": [
		{
			"files": [
				"*.yaml",
				"*.yml"
			],
			"options": {
				"tabWidth": 2,
				"useTabs": false,
				"singleQuote": false
			}
		},
		{
			"files": [
				"*.css"
			],
			"options": {
				"printWidth": 100
			}
		}
	]
}
