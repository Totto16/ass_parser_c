{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"isolatedModules": false,
		"module": "CommonJS",
		"lib": [
			"es5",
		],
		"types": [
			"node"
		],
		"checkJs": true,
		"allowJs": true,
		"composite": true
	},
	"exclude": [
		"node_modules/"
	],
	"include": [
		"scripts/**/*.ts",
		"scripts/**/*.js"
	],
	"ts-node": {
		"files": true
	}
}
