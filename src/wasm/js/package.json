{
	"name": "ass_parser_wasm",
	"version": "0.0.1",
	"description": "",
	"scripts": {
		"dev": "webpack serve --open --mode=development",
		"build:dev": "webpack --mode=development",
		"build:prod": "webpack --mode=production",
		"lint": "pnpm lint:prettier && pnpm run lint:eslint",
		"lint:prettier:base": "prettier --config .prettierrc --ignore-path .prettierignore",
		"lint:prettier": "pnpm lint:prettier:base -c .",
		"format": "pnpm lint:prettier:base -w .",
		"lint:eslint": "eslint --color .",
		"lint:lockfile": "pnpm dedupe --check",
		"build:check-only": "tsc --noEmit",
		"generate": "TS_NODE_PROJECT=./tsconfig.script.json npx ts-node scripts/generator.ts -i ./static/build/ass_parser.wasm -o ./src/generated/wasm_exports.ts"
	},
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@tsconfig/strictest": "^2.0.8",
		"@types/node": "^24.10.1",
		"@types/webpack": "^5.28.5",
		"copy-webpack-plugin": "^13.0.1",
		"css-loader": "^7.1.2",
		"css-minimizer-webpack-plugin": "^7.0.2",
		"eslint": "^9.39.1",
		"eslint-webpack-plugin": "^5.0.2",
		"globals": "^16.5.0",
		"html-webpack-plugin": "^5.6.5",
		"ignore-loader": "^0.1.2",
		"jiti": "^2.6.1",
		"mini-css-extract-plugin": "^2.9.4",
		"prettier": "^3.6.2",
		"style-loader": "^4.0.0",
		"ts-loader": "^9.5.4",
		"ts-node": "^10.9.2",
		"type-testing": "^0.2.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.47.0",
		"wasmparser": "^5.11.1",
		"webpack": "^5.103.0",
		"webpack-cli": "^6.0.1",
		"webpack-dev-server": "^5.2.2"
	},
	"packageManager": "pnpm@10.23.0",
	"engines": {
		"node": "24.11.1"
	},
	"private": true,
	"pnpm": {
		"onlyBuiltDependencies": [],
		"ignoredBuiltDependencies": [],
		"ignorePatchFailures": false
	}
}
